# Furyodachi save API (furyo-api.jeremyfarnault.com). No pages: only /api/save,
# called by the game with the shared session cookie.

# Database (Neon): the same database as the other apps
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Better Auth: the same secret and auth URL as the other apps, so it can read their sessions
BETTER_AUTH_SECRET="your-secret-here-min-32-chars"
BETTER_AUTH_URL="http://localhost:3003"

# Cookie domain (production only)
COOKIE_DOMAIN=".yourdomain.com"

# The game's origin, the only one CORS allows (default: https://furyodachi.jeremyfarnault.com).
# Localhost is also allowed outside production.
# FURYODACHI_ORIGIN="https://furyodachi.jeremyfarnault.com"

# Google sign-in isn't used here, but @jf/auth reads these
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
