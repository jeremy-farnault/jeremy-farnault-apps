  },
  "devDependencies": {
    "@jf/config": "workspace:*",
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
