# Database (Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="your-secret-here-min-32-chars"
BETTER_AUTH_URL="http://localhost:3018"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3018"

# Auth app URL
NEXT_PUBLIC_AUTH_URL="http://localhost:3003"

# Cookie domain (production only)
COOKIE_DOMAIN=".yourdomain.com"

# S3 bucket holding person avatars (shared with the other apps)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=
