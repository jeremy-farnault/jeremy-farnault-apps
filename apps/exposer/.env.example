# Server-side session reads + handle writes need the shared DB and auth secret.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
BETTER_AUTH_SECRET="your-secret-here-min-32-chars"
# Required because importing @jf/auth constructs a Resend client at module load.
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="no-reply@yourdomain.com"
# Better Auth needs a baseURL because crossSubdomainCookies is enabled in the shared config.
BETTER_AUTH_URL="http://localhost:3016"
NEXT_PUBLIC_APP_URL="http://localhost:3016"

# S3 photo storage (public-read bucket, per-user key prefix exposer/<userId>/...).
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="eu-central-1"
AWS_S3_BUCKET_NAME="your-s3-bucket-name"

# Public cross-app URLs.
NEXT_PUBLIC_AUTH_URL="http://localhost:3003"
NEXT_PUBLIC_EXPOSER_URL="http://localhost:3016"

# Sibling app URLs (used by the shared app switcher)
NEXT_PUBLIC_AIDER_URL="http://localhost:3015"
NEXT_PUBLIC_NOTER_URL="http://localhost:3005"
NEXT_PUBLIC_JOURNALER_URL="http://localhost:3006"
NEXT_PUBLIC_ROUTINER_URL="http://localhost:3007"
NEXT_PUBLIC_CLASSER_URL="http://localhost:3008"
NEXT_PUBLIC_FINANCER_URL="http://localhost:3009"
NEXT_PUBLIC_PLACER_URL="http://localhost:3010"
NEXT_PUBLIC_GAINER_URL="http://localhost:3011"
NEXT_PUBLIC_DOSER_URL="http://localhost:3013"
