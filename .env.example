# Database (Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="your-secret-here-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# App URL (set per-app in apps/*/env.local if needed)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# App URLs (used by app switcher and cross-app navigation)
NEXT_PUBLIC_AIDER_URL="http://localhost:3015"
NEXT_PUBLIC_EXPOSER_URL="http://localhost:3016"
NEXT_PUBLIC_NOTER_URL="http://localhost:3005"
NEXT_PUBLIC_JOURNALER_URL="http://localhost:3006"
NEXT_PUBLIC_ROUTINER_URL="http://localhost:3007"
NEXT_PUBLIC_CLASSER_URL="http://localhost:3008"
NEXT_PUBLIC_FINANCER_URL="http://localhost:3009"
NEXT_PUBLIC_PLACER_URL="http://localhost:3010"
NEXT_PUBLIC_GAINER_URL="http://localhost:3011"
NEXT_PUBLIC_TRACER_URL="http://localhost:3012"
NEXT_PUBLIC_DOSER_URL="http://localhost:3013"
NEXT_PUBLIC_ORGANISER_URL="http://localhost:3017"

# Mapbox (Tracer)
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Aider Pi backend (Cloudflare Tunnel) — server-only, reached via the /api BFF proxy
AIDER_PI_URL="https://aider-pi.example.com"
AIDER_PI_SHARED_SECRET="shared-server-to-server-secret"

# Resend (email verification)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="no-reply@yourdomain.com"

# AWS S3 (Journaler image uploads)
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="eu-central-1"
AWS_S3_BUCKET_NAME="your-s3-bucket-name"

# VAPID keys (Web Push — Noter)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"

# Vercel Cron secret (set in Vercel dashboard; auto-injected into cron requests)
# Generate with: openssl rand -hex 32
CRON_SECRET="your-cron-secret"
